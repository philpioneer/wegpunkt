# Kopiere diese Datei nach ".env" und passe sie an. Arriba liest sie beim Start automatisch.

# Domain, unter der die Instanz erreichbar ist (ohne https://). Später nicht mehr ändern!
ARRIBA_DOMAIN=sport.example.de
# Dein Name im Fediverse: @philipp@sport.example.de. Später nicht mehr ändern!
ARRIBA_USERNAME=philipp
# Das einzige Passwort. Eine Registrierung gibt es nicht.
ARRIBA_PASSWORD=bitte-ein-langes-passwort

# Startwerte für das Profil. Beides lässt sich später in der Oberfläche unter "Profil" ändern.
ARRIBA_DISPLAY_NAME=Philipp
ARRIBA_SUMMARY=Gravel, Enduro, Joggen und Calisthenics.

ARRIBA_DATA_DIR=data
ARRIBA_TIMEZONE=Europe/Berlin
# Radius in Metern um Start und Ziel, der nicht öffentlich gezeigt wird
ARRIBA_PRIVACY_RADIUS_M=200
# Vorschaubilder für Fediverse-Beiträge mit Kartenhintergrund von OpenStreetMap (1 oder 0)
ARRIBA_MAP_PREVIEWS=1
# Adresse und Port, auf denen der Server lauscht
ARRIBA_HOST=127.0.0.1
ARRIBA_PORT=8000
